            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E-Commerce Platform\",\n  \"description\": \"Building a new e-commerce platform\",\n  \"status\": \"ACTIVE\",\n  \"startDate\": \"2024-02-01T00:00:00\",\n  \"endDate\": \"2024-06-30T00:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects",
